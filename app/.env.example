# Supabase project (Settings → API). The anon/publishable key is safe in the browser;
# all access is enforced by RLS. The Gemini key lives ONLY in the edge function secrets.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side AI keys (GEMINI_API_KEY, GROQ_API_KEY) are Supabase function secrets.
# Never add them here or with a VITE_ prefix: VITE_ variables are shipped to the browser.
